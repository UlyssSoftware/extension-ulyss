{
  "manifest_version": 3,
  "name": "Extension Ulyss",
  "version": "1.8.34",
  "description": "Outils Limo Dem dans Ulyss : chiffrage par la grille ou par forfait, niveau de prix dans la liste des dossiers, confirmation de rendez-vous, rappel du déménagement et demande d'avis par e-mail, taux de charge du Planning, module Avis clients, activité commerciale.",
  "permissions": [
    "storage",
    "downloads",
    "downloads.ui"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ulyss.fr/*",
        "https://fraisseix.staging.unova.fr/*"
      ],
      "js": [
        "modules.js",
        "engine.js",
        "content.js",
        "rdv.js",
        "rappel.js",
        "charge.js",
        "logo.js",
        "avis.js",
        "demande-avis.js",
        "deplacement.js",
        "prix.js",
        "commercial.js",
        "dashboard2.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/maps/place/*"
      ],
      "js": [
        "maps-avis.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "fond.js"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/UlyssSoftware/extension-ulyss/*",
    "https://cdn.jsdelivr.net/gh/UlyssSoftware/*",
    "https://www.ulyss-software.com/extension-ulyss/*"
  ]
}