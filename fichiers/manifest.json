{
  "manifest_version": 3,
  "name": "Extension Ulyss",
  "version": "1.8.15",
  "description": "Outils Limo Dem dans Ulyss : chiffrage par la grille ou par forfait et moyens par étape dans la pré-planification, confirmation de rendez-vous et rappel du déménagement par e-mail.",
  "permissions": [
    "storage",
    "downloads",
    "downloads.ui"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ulyss.fr/*",
        "https://fraisseix.staging.unova.fr/*"
      ],
      "js": [
        "engine.js",
        "content.js",
        "rdv.js",
        "rappel.js",
    "charge.js",
    "logo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "fond.js"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/UlyssSoftware/extension-ulyss/*",
    "https://cdn.jsdelivr.net/gh/UlyssSoftware/*",
    "https://www.ulyss-software.com/extension-ulyss/*"
  ]
}
